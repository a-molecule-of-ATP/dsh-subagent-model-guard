{
  "name": "@local/dsh-subagent-model-guard",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness plugin that gates subagent delegation by provider/model allow-list, including the silent parent-route fallback, with optional official-tool replacement.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "subagent",
    "model-guard",
    "allow-list"
  ],
  "license": "MIT",
  "author": "dafeiyu",
  "repository": {
    "type": "git",
    "url": "https://github.com/dafeiyu/dsh-subagent-model-guard.git"
  },
  "bugs": {
    "url": "https://github.com/dafeiyu/dsh-subagent-model-guard/issues"
  },
  "homepage": "https://github.com/dafeiyu/dsh-subagent-model-guard#readme",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "node_modules/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
